{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/insurance-demo/**",
        "destination": "/insurance-demo/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/insurance-demo",
        "destination": "/insurance-demo/",
        "type": 301
      }
    ],
    "predeploy": [
      "node scripts/build-with-demo.mjs --verify-only"
    ]
  }
}
